# Nom du projet Docker (sert aux noms de conteneurs/volumes)
COMPOSE_PROJECT_NAME=app

APP_ENV=dev
APP_TZ=Europe/Paris

# Ports publiés sur ta machine
WEB_PUBLISHED_HOST=127.0.0.1
WEB_PORT=8080
PMA_PUBLISHED_HOST=127.0.0.1
PMA_PORT=8081
DB_PUBLISHED_HOST=127.0.0.1
DB_PUBLISHED_PORT=3307

# DB (dans le réseau docker)
DB_HOST=db
DB_PORT=3306
DB_NAME=app
DB_USER=app_user
DB_PASSWORD=change_me_local_db_password

MYSQL_ROOT_PASSWORD=change_me_local_root_password

# Mailpit
MAILPIT_PUBLISHED_HOST=127.0.0.1
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PUBLISHED_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
