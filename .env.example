# Nom du projet Docker (sert aux noms de conteneurs/volumes)
COMPOSE_PROJECT_NAME=app

APP_ENV=dev
APP_TZ=Europe/Paris

# Ports publiés sur ta machine
WEB_PUBLISHED_HOST=127.0.0.1
WEB_PORT=8080
PMA_PUBLISHED_HOST=127.0.0.1
PMA_PORT=8081
DB_PUBLISHED_HOST=127.0.0.1
DB_PUBLISHED_PORT=3307

# DB (dans le réseau docker)
DB_HOST=db
DB_PORT=3306
DB_NAME=app
DB_USER=app_user
DB_PASSWORD=change_me_local_db_password

MYSQL_ROOT_PASSWORD=change_me_local_root_password

# Mailpit
MAILPIT_PUBLISHED_HOST=127.0.0.1
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PUBLISHED_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025

# Configuration SMTP de l'application en développement
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=
MAIL_FROM=no-reply@example.test
MAIL_FROM_NAME=Portfolio Guillaume
CONTACT_TO=developer@example.test

# Cloudflare Turnstile — clés officielles de test uniquement
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_EXPECTED_ACTION=contact

# Limitation du formulaire de contact
CONTACT_RATE_LIMIT_MAX_ATTEMPTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900
CONTACT_RATE_LIMIT_BLOCK_SECONDS=3600

# Secret local factice, jamais à réutiliser en production
CONTACT_IP_HASH_KEY=local-only-rate-limit-pepper-please-change

# Vide en local : le port Apache est appelé directement sans Caddy
CONTACT_TRUSTED_PROXIES=
