APP_ENV=prod
APP_TZ=Europe/Paris

DB_NAME=portfolio
DB_USER=portfolio_user
DB_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_password

DOMAIN=example.com
ACME_EMAIL=admin@example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
SMTP_ENCRYPTION=tls
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Portfolio
CONTACT_TO=contact@example.com

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=replace_with_the_public_site_key
TURNSTILE_SECRET_KEY=replace_with_the_private_secret_key
TURNSTILE_ALLOWED_HOSTNAMES=guillaumemaignaut.com,www.guillaumemaignaut.com
TURNSTILE_EXPECTED_ACTION=contact

# Limitation du formulaire de contact
CONTACT_RATE_LIMIT_MAX_ATTEMPTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900
CONTACT_RATE_LIMIT_BLOCK_SECONDS=3600

# Secret aléatoire distinct des autres mots de passe, minimum 32 caractères
CONTACT_IP_HASH_KEY=replace_with_a_distinct_random_secret_of_at_least_32_characters

# Réseau Docker confirmé sur le VPS le 2 septembre 2026
# À remesurer si app_net est supprimé puis reconstruit
CONTACT_TRUSTED_PROXIES=172.18.0.0/16
